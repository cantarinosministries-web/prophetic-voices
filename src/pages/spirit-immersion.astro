---
// Spirit Immersion — movimento de oração em línguas, 1 hora por dia. Números em src/data/spirit.js;
// inscrição pela conta de leitor (worker/spirit.js); a jornada fica em /conta.html#spirit.
import Base from '../layouts/Base.astro';
import { destaques, frutos, constancia, ultimaEdicao, fonte, relatos } from '../data/spirit.js';
const pct = (n) => Math.round((100 * n) / fonte.respostas);
const fmt = (n) => n.toLocaleString('pt-BR');
const ticks = Array.from({ length: 60 }, (_, i) => i);
---
<Base page="spirit" title="Spirit Immersion — The Prophetic Voices" description="Spirit Immersion: um movimento de oração em línguas, uma hora por dia. Edição 2027: 100 dias, de 1º de janeiro a 10 de abril.">
  <Fragment slot="head">
    <meta property="og:title" content="Spirit Immersion — uma hora por dia orando no Espírito" />
    <meta property="og:description" content="100 dias de oração em línguas, de 1º de janeiro a 10 de abril de 2027. Inscreva-se." />
    <meta property="og:image" content="https://thepropheticvoices.com.br/media/pv07-cobre.png" />
  </Fragment>

  <!-- HERO -->
  <section class="si-hero">
    <div class="si-grid" aria-hidden="true"></div>
    <svg class="si-rings" viewBox="0 0 600 600" aria-hidden="true">
      <circle cx="300" cy="300" r="290" class="r1" />
      <g class="r-ticks">{ticks.map((i) => <line x1="300" y1="22" x2="300" y2={i % 5 === 0 ? 44 : 32} transform={`rotate(${i * 6} 300 300)`} />)}</g>
      <circle cx="300" cy="300" r="230" class="r2" />
      <circle cx="300" cy="300" r="170" class="r3" />
      <circle cx="300" cy="300" r="230" class="r-arc" pathLength="100" />
      <circle cx="300" cy="300" r="4" class="r-dot" />
    </svg>
    <div class="wrap si-hero-in">
      <div class="si-meta"><span>SI · 2027</span><span data-en="PRAYER MOVEMENT">MOVIMENTO DE ORAÇÃO</span><span class="si-live"><i></i><span id="siHeroStatus" data-en="ENROLLMENT OPEN">INSCRIÇÕES ABERTAS</span></span></div>
      <h1 class="disp si-h1">Spirit<br /><span>Immersion</span></h1>
      <p class="si-lede" data-en="One hour a day praying in the Spirit. A movement born in a home in January 2024 that now gathers hundreds of people across Brazil and among the nations.">Uma hora por dia orando no Espírito. Um movimento que nasceu numa casa em janeiro de 2024 e hoje reúne centenas de pessoas pelo Brasil e nas nações.</p>
      <div class="si-clock" aria-label="1 hora por dia"><b>01:00:00</b><span data-en="/ DAY · 100 DAYS · JAN 1 → APR 10, 2027">/ DIA · 100 DIAS · 01.01 → 10.04.2027</span></div>
      <div class="si-ctas">
        <a href="#inscricao" class="btn btn-creme" data-en="Join the 2027 edition">Participar da edição 2027</a>
        <a href="#frutos" class="btn btn-ghost" data-en="See the fruit">Ver os frutos</a>
      </div>
    </div>
  </section>

  <!-- VISÃO -->
  <section class="pad si-visao">
    <div class="wrap">
      <div class="eyebrow" data-en="The vision">A visão</div>
      <h2 class="si-h2 rv"><span data-en="Before a house of prayer,">Antes de uma casa de oração,</span> <em data-en="a life of prayer.">uma vida de oração.</em></h2>
      <div class="si-pilares">
        <article class="si-pilar rv">
          <span class="si-n">01</span>
          <h3 data-en="One hour a day">Uma hora por dia</h3>
          <p data-en="A simple, daily, possible rhythm: one hour set apart before the Throne of Grace, inside ordinary life, at home, before the routine.">Um ritmo simples, diário e possível: uma hora separada diante do Trono da Graça, dentro da vida comum, em casa, antes da rotina.</p>
        </article>
        <article class="si-pilar rv" style="transition-delay:.12s">
          <span class="si-n">02</span>
          <h3 data-en="Praying in tongues">Oração em línguas</h3>
          <p data-en="“Whoever speaks in a tongue speaks not to men but to God” (1 Cor 14:2). Praying in the Holy Spirit, the believer is built up in the faith (Jude 20).">“Quem fala em língua não fala aos homens, mas a Deus” (1Co 14.2). Orando no Espírito Santo, o crente é edificado na fé (Jd 20).</p>
        </article>
        <article class="si-pilar rv" style="transition-delay:.24s">
          <span class="si-n">03</span>
          <h3 data-en="Grace, not strength">Graça, não força</h3>
          <p data-en="It is not a performance challenge. It is a response to the “spirit of grace and supplication” (Zech 12:10) that teaches us to come back, day after day.">Não é um desafio de desempenho. É resposta ao “espírito de graça e de súplicas” (Zc 12.10) que nos educa a voltar, dia após dia.</p>
        </article>
      </div>

      <div class="si-origem rv">
        <figure class="si-verso">
          <span lang="grc">ἐν πνεύματι ἁγίῳ προσευχόμενοι</span>
          <figcaption data-en="JUDE 20 · “PRAYING IN THE HOLY SPIRIT”">JD 20 · “ORANDO NO ESPÍRITO SANTO”</figcaption>
        </figure>
        <div>
          <div class="eyebrow" data-en="How it began">Como nasceu</div>
          <p data-en="In 2023, Gabriel Cantarino was struck by Obed-Edom (2 Sam 6:11): before David’s tent, God made a home a dwelling place for the Ark, and that family went on to minister day and night. A prayer was born: “Before the church becomes a house of prayer, I want my home to be one; and before my home, I want to be one.” On January 1, 2024, he returned to the practice of setting apart hours of the day to pray in tongues and was inspired by the Spirit to establish one hour a day for it. Months later, the Spirit led him to open it to the Church, and the Spirit Immersion was born.">Em 2023, Gabriel Cantarino foi atravessado pela história de Obede-Edom (2Sm 6.11): antes da Tenda de Davi, Deus fez de uma casa a habitação da Arca, e aquela família passou a ministrar dia e noite. Nasceu uma oração: “Antes de a igreja ser uma casa de oração, quero que a minha casa seja; e, antes da minha casa, quero eu ser uma casa de oração.” Em 1º de janeiro de 2024, ele voltou à prática de separar horas do dia para orar em línguas e foi inspirado pelo Espírito a estabelecer uma hora por dia para isso. Meses depois, o Espírito o levou a abrir isso à Igreja, e nasceu o Spirit Immersion.</p>
          <p class="si-sub" data-en="The goal is not to fill a 24/7 schedule, but to form inside each person an inner structure that sustains a real life of prayer, one that does not depend on a shift at church.">O alvo não é preencher uma escala 24/7, mas formar dentro de cada pessoa uma estrutura interior que sustente uma vida de oração de verdade, que não dependa de um turno na igreja.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FRUTOS / ESTATÍSTICAS -->
  <section class="pad si-frutos" id="frutos">
    <div class="si-grid si-grid-soft" aria-hidden="true"></div>
    <div class="wrap" style="position:relative">
      <div class="si-head">
        <div>
          <div class="eyebrow" data-en="The fruit · data">Os frutos · dados</div>
          <h2 class="si-h2 rv"><span data-en="What happens when">O que acontece quando</span> <em data-en="people keep praying.">pessoas permanecem orando.</em></h2>
        </div>
        <p class="si-fonte mono" data-en={`SOURCE · ${fonte.respostas} CLOSING SURVEYS · JAN 2024 + DEC 2025–JAN 2026`}>FONTE · {fonte.respostas} FORMULÁRIOS DE ENCERRAMENTO · JAN 2024 + DEZ 2025–JAN 2026</p>
      </div>

      <div class="si-kpis">
        {destaques.map((d, i) => (
          <div class="si-kpi rv" style={`transition-delay:${i * 90}ms`}>
            <span class="si-c tl"></span><span class="si-c br"></span>
            <span class="si-kpi-i mono">{String(i + 1).padStart(2, '0')} / 04</span>
            <b class="si-num" data-alvo={d.valor} data-suf={d.sufixo}>{fmt(d.valor)}{d.sufixo}</b>
            <p data-en={d.en}>{d.pt}</p>
          </div>
        ))}
      </div>

      <div class="si-painel">
        <div class="si-barras rv">
          <div class="si-ptit mono"><span data-en="REPORTED EFFECTS">EFEITOS RELATADOS</span><span>% · N={fonte.respostas}</span></div>
          <ul>
            {frutos.map((f, i) => (
              <li style={`--p:${pct(f.n)}%;--d:${i * 60}ms`}>
                <span class="si-bl" data-en={f.en}>{f.pt}</span>
                <span class="si-bt"><i></i></span>
                <b class="mono">{pct(f.n)}%</b>
              </li>
            ))}
          </ul>
          <p class="si-nota" data-en="Multiple choice: each participant marked the effects they perceived in themselves.">Múltipla escolha: cada participante marcou os efeitos que percebeu em si.</p>
        </div>

        <div class="si-lado">
          <div class="si-box rv">
            <div class="si-ptit mono"><span data-en="LAST EDITION">ÚLTIMA EDIÇÃO</span><span>N={ultimaEdicao.n}</span></div>
            <div class="si-gauges">
              {[
                { v: ultimaEdicao.cemDias, pt: 'quiseram seguir para 100 dias de oração e consagração', en: 'wanted to go on to 100 days of prayer and consecration' },
                { v: ultimaEdicao.consagracao, pt: 'sentiram um chamado a um tempo intencional de consagração', en: 'felt called to an intentional season of consecration' },
                { v: ultimaEdicao.linguas, pt: 'já oravam com o dom de línguas ativo', en: 'already prayed with the gift of tongues active' },
              ].map((g) => (
                <div class="si-gauge">
                  <div class="g-ring"><svg viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="52" class="g-bg" pathLength="100" /><circle cx="60" cy="60" r="52" class="g-v" pathLength="100" style={`--v:${g.v}`} /></svg><b class="mono">{g.v}%</b></div>
                  <p data-en={g.en}>{g.pt}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="si-box rv">
            <div class="si-ptit mono"><span data-en="CONSTANCY · 31 DAYS">CONSTÂNCIA · 31 DIAS</span><span data-en="MEDIAN">MEDIANA</span></div>
            <div class="si-cal31" aria-hidden="true">{Array.from({ length: constancia.de }, (_, i) => <i class={i < constancia.mediana ? 'on' : ''} style={`--d:${i * 30}ms`}></i>)}</div>
            <p class="si-big"><b class="mono">{constancia.mediana}</b><span>/{constancia.de}</span></p>
            <p data-en={`Half of the participants prayed ${constancia.mediana} days or more; ${constancia.vinteOuMais}% prayed 20 days or more. Constancy is not perfection: it is coming back.`}>Metade dos participantes orou {constancia.mediana} dias ou mais; {constancia.vinteOuMais}% oraram 20 dias ou mais. Constância não é perfeição: é voltar.</p>
          </div>

          <div class="si-box si-alcance rv">
            <div><b class="mono">{ultimaEdicao.estados}</b><span data-en="states + the Federal District">estados + o DF</span></div>
            <div><b class="mono">{ultimaEdicao.paises}</b><span data-en="nations">nações</span></div>
            <div><b class="mono">{ultimaEdicao.idadeMin}–{ultimaEdicao.idadeMax}</b><span data-en="years old">anos de idade</span></div>
          </div>
        </div>
      </div>
      <p class="si-metodo" data-en="Only aggregate numbers and five anonymous excerpts are published. Percentages of the effects are over all 382 answers; the “last edition” panel uses the 133 answers of the Dec 2025–Jan 2026 edition (location and age were asked only then).">Publicamos apenas números agregados e cinco trechos sem identificação. Os percentuais de efeitos são sobre as 382 respostas; o painel “última edição” usa as 133 respostas da edição de dez/2025–jan/2026 (localidade e idade só foram perguntadas nela).</p>
    </div>
  </section>

  <!-- RELATOS -->
  <section class="pad si-relatos">
    <div class="wrap">
      <div class="si-head">
        <div>
          <div class="eyebrow" data-en="In their own words">Na voz de quem orou</div>
          <h2 class="si-h2 rv"><span data-en="Five">Cinco</span> <em data-en="testimonies.">testemunhos.</em></h2>
        </div>
        <p class="si-fonte mono" data-en="WITHOUT IDENTIFICATION · EXCERPTS EDITED FOR CLARITY, WITH NAMES, PLACES AND PERSONAL DETAILS REMOVED">SEM IDENTIFICAÇÃO · TRECHOS EDITADOS PARA CLAREZA, SEM NOMES, LUGARES OU DADOS PESSOAIS</p>
      </div>
      <div class="si-rel-grade">
        {relatos.map((r, i) => (
          <figure class={`si-rel rv${i === 0 ? ' si-rel-maior' : ''}`} style={`transition-delay:${i * 80}ms`}>
            <span class="si-c tl"></span><span class="si-c br"></span>
            <div class="si-rel-top mono"><span data-en={`ACCOUNT ${String(i + 1).padStart(2, '0')} / 05`}>RELATO {String(i + 1).padStart(2, '0')} / 05</span><span data-en={r.edicao.en}>{r.edicao.pt}</span></div>
            <blockquote data-en={r.en}>{r.pt}</blockquote>
            <figcaption class="mono" data-en={r.tema.en}>{r.tema.pt}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- EDIÇÃO 2027 -->
  <section class="pad si-edicao">
    <div class="wrap si-ed-grid">
      <div>
        <div class="eyebrow" data-en="2027 edition">Edição 2027</div>
        <h2 class="si-h2 rv">100 <em data-en="days.">dias.</em></h2>
        <dl class="si-dl rv">
          <div><dt class="mono" data-en="START">INÍCIO</dt><dd data-en="January 1, 2027">1º de janeiro de 2027</dd></div>
          <div><dt class="mono" data-en="END">FIM</dt><dd data-en="April 10, 2027">10 de abril de 2027</dd></div>
          <div><dt class="mono" data-en="RHYTHM">RITMO</dt><dd data-en="1 hour a day praying in tongues">1 hora por dia orando em línguas</dd></div>
          <div><dt class="mono" data-en="IN YOUR ACCOUNT">NA SUA CONTA</dt><dd data-en="Day counter, daily check-in, daily testimonies and PDF devotionals">Contagem dos dias, check diário, testemunhos diários e devocionais em PDF</dd></div>
        </dl>
        <p class="si-inscritos mono" id="siInscritos" hidden></p>
      </div>
      <div class="si-cal100 rv" aria-hidden="true">{Array.from({ length: 100 }, (_, i) => <i style={`--d:${i * 18}ms`}><span>{i + 1}</span></i>)}</div>
    </div>
  </section>

  <!-- INSCRIÇÃO -->
  <section class="pad si-insc" id="inscricao">
    <div class="wrap">
      <div class="si-insc-card rv">
        <span class="si-c tl"></span><span class="si-c br"></span>
        <div>
          <div class="eyebrow" data-en="Enrollment">Inscrição</div>
          <h2 class="si-h2"><span data-en="Enter the">Entre no</span> <em>Spirit Immersion.</em></h2>
          <p class="si-insc-p" data-en="Sign up with an account you already have. Your journey stays in your account on the site: you mark each day you completed your hour of prayer, write what God is doing and receive the devotionals.">Inscreva-se com uma conta que você já tem. A sua jornada fica na sua conta do site: você marca cada dia em que completou a hora de oração, escreve o que Deus está fazendo e recebe os devocionais.</p>
        </div>
        <div id="siInsc" class="si-insc-box"><p class="conta-carregando">…</p></div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src="/conta/botoes.js"></script>
    <script is:inline>
      (function () {
        var L = window.PV_LOGIN, esc = L.esc;
        var en = function () { return document.documentElement.lang === 'en'; };
        // textos PT/EN: o elemento guarda o português e troca pelo data-en
        function traduzir() {
          document.querySelectorAll('[data-en]').forEach(function (el) {
            if (!el.hasAttribute('data-pt')) el.setAttribute('data-pt', el.textContent);
            el.textContent = en() ? el.getAttribute('data-en') : el.getAttribute('data-pt');
          });
          desenharInsc();
        }
        window.addEventListener('pv:lang', function () { setTimeout(traduzir, 0); });

        // contadores e barras animam quando aparecem
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target; io.unobserve(el);
            if (el.classList.contains('si-num')) {
              var alvo = +el.getAttribute('data-alvo'), suf = el.getAttribute('data-suf') || '', t0 = performance.now(), dur = 1600;
              (function passo(t) {
                var k = Math.min(1, (t - t0) / dur), v = Math.round(alvo * (1 - Math.pow(1 - k, 3)));
                el.textContent = v.toLocaleString(en() ? 'en-US' : 'pt-BR') + suf;
                if (k < 1) requestAnimationFrame(passo);
              })(t0);
            } else el.classList.add('vivo');
          });
        }, { threshold: 0.3 });
        document.querySelectorAll('.si-num, .si-barras, .si-gauges, .si-cal31, .si-cal100').forEach(function (el) { io.observe(el); });

        // grade dos 100 dias: cada número acende sob o mouse (ou o dedo) e apaga devagar, deixando um rastro
        var g100 = document.querySelector('.si-cal100');
        if (g100) {
          var acender = function (x, y) {
            var c = document.elementFromPoint(x, y);
            c = c && c.closest ? c.closest('.si-cal100 i') : null;
            if (!c) return;
            c.classList.add('luz');
            clearTimeout(c._t);
            c._t = setTimeout(function () { c.classList.remove('luz'); }, 260);
          };
          g100.addEventListener('pointermove', function (e) { acender(e.clientX, e.clientY); });
          g100.addEventListener('pointerdown', function (e) { acender(e.clientX, e.clientY); });
          g100.addEventListener('touchmove', function (e) { var t = e.touches[0]; if (t) acender(t.clientX, t.clientY); }, { passive: true });
          // depois da entrada em cascata, a grade passa a reagir sem atraso
          new IntersectionObserver(function (es, o) { if (es[0].isIntersecting) { o.disconnect(); setTimeout(function () { g100.classList.add('pronto'); }, 2600); } }).observe(g100);
        }

        // inscritos na edição
        fetch('/api/publico/spirit').then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
          if (!d) return;
          var box = document.getElementById('siInscritos');
          if (d.edicao.fase === 'durante') {
            document.getElementById('siHeroStatus').setAttribute('data-pt', 'DIA ' + d.edicao.dia_atual + ' DE 100');
            document.getElementById('siHeroStatus').setAttribute('data-en', 'DAY ' + d.edicao.dia_atual + ' OF 100');
          }
          if (d.edicao.fase === 'depois') {
            document.getElementById('siHeroStatus').setAttribute('data-pt', 'EDIÇÃO 2027 ENCERRADA');
            document.getElementById('siHeroStatus').setAttribute('data-en', '2027 EDITION CLOSED');
          }
          if (d.inscritos >= 10) {
            box.hidden = false;
            box.setAttribute('data-pt', '● ' + d.inscritos.toLocaleString('pt-BR') + ' PESSOAS JÁ INSCRITAS');
            box.setAttribute('data-en', '● ' + d.inscritos.toLocaleString('en-US') + ' PEOPLE ALREADY ENROLLED');
            box.textContent = 'x';
          }
          traduzir();
        }).catch(function () {});

        // ------------------------------------------------ inscrição
        var params = new URLSearchParams(location.search);
        var S = null, msg = '', enviando = false;
        var T = {
          pt: { consent: 'Concordo que o site guarde o registro diário da minha oração e os testemunhos que eu escrever. São informações sobre a minha fé: só eu vejo o meu registro, e cada testemunho tem a autorização que eu escolher. Posso sair e apagar tudo quando quiser.', dev: 'Quero receber os devocionais em PDF no meu e-mail.', priv: 'Veja a <a href="/privacidade.html#spirit">Política de Privacidade</a>.', escolha: 'Escolha como entrar:', marque: 'Marque a caixa de concordância para continuar.', participar: 'Quero participar', ja: 'Você já está inscrito na edição 2027.', ir: 'Ir para a minha jornada →', ola: 'Olá, {n}.', breve: 'As inscrições abrem em breve.', fim: 'A edição 2027 já terminou. Fique de olho na próxima.', entrando: 'Inscrevendo…' },
          en: { consent: 'I agree that the site keeps a daily record of my prayer and the testimonies I write. This is information about my faith: only I see my record, and each testimony carries the permission I choose. I can leave and erase everything at any time.', dev: 'I want to receive the PDF devotionals by e-mail.', priv: 'See our <a href="/privacidade.html#spirit">Privacy Policy</a>.', escolha: 'Choose how to sign in:', marque: 'Tick the consent box to continue.', participar: 'I want to join', ja: 'You are already enrolled in the 2027 edition.', ir: 'Go to my journey →', ola: 'Hello, {n}.', breve: 'Enrollment opens soon.', fim: 'The 2027 edition has ended. Stay tuned for the next one.', entrando: 'Enrolling…' }
        };
        var t = function (k) { return T[en() ? 'en' : 'pt'][k]; };
        var box = document.getElementById('siInsc');
        var consentido = false, devocionais = true, fase = 'antes';

        function voltaUrl() { return '/spirit-immersion.html?inscrever=1&dev=' + (devocionais ? 1 : 0); }
        function inscrever(dev) {
          if (enviando) return; enviando = true; msg = t('entrando'); desenharInsc();
          L.api('/conta/spirit/inscrever', 'POST', { consentimento: true, devocionais: dev }).then(function () {
            location.replace('/conta.html#spirit');
          }).catch(function (er) { enviando = false; msg = er.message; history.replaceState(null, '', location.pathname + '#inscricao'); desenharInsc(); });
        }
        function caixas() {
          return '<label class="si-check"><input type="checkbox" id="siConsent"' + (consentido ? ' checked' : '') + '><span>' + esc(t('consent')) + '</span></label>' +
            '<label class="si-check"><input type="checkbox" id="siDev"' + (devocionais ? ' checked' : '') + '><span>' + esc(t('dev')) + '</span></label>' +
            '<p class="si-priv">' + t('priv') + '</p>';
        }
        function desenharInsc() {
          if (!S) return;
          var h = '';
          if (S.leitor && S.leitor.spirit) {
            h = '<p class="si-ok">' + esc(t('ja')) + '</p><a class="btn btn-creme" href="/conta.html#spirit">' + esc(t('ir')) + '</a>';
          } else if (fase === 'depois') {
            h = '<p>' + esc(t('fim')) + '</p>';
          } else if (S.leitor) {
            h = '<p class="si-ola">' + esc(t('ola').replace('{n}', String(S.leitor.nome || '').split(' ')[0])) + '</p>' + caixas() +
              '<button type="button" class="btn btn-creme" id="siPart"' + (enviando ? ' disabled' : '') + '>' + esc(t('participar')) + '</button>';
          } else if (S.provedores && S.provedores.length) {
            h = caixas() + '<p class="si-escolha">' + esc(t('escolha')) + '</p><div id="siLogins" class="' + (consentido ? '' : 'si-trava') + '">' + L.botoes(S.provedores, { volta: voltaUrl() }) + '</div>';
          } else {
            h = '<p>' + esc(t('breve')) + '</p>';
          }
          if (msg) h += '<p class="si-msg" role="status">' + esc(msg) + '</p>';
          box.innerHTML = h;
          var c = document.getElementById('siConsent'), d = document.getElementById('siDev');
