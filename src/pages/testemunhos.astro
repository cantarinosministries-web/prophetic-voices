---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
// Formulário do Google (respostas chegam na conta do ministério)
const FORM = 'https://docs.google.com/forms/d/1bAbQIaF7zfDyQQakoTfmt7s6xaLIBsVFYIvrw3KBS5U/viewform';
---
<Base page="testemunhos" title="Testemunhos — The Prophetic Voices" description="Conte como Deus tem abençoado sua vida por meio do ministério The Prophetic Voices.">
  <PageHero k="tes" eyebrow="Testemunhos" title="Testemunhos"
    lede="Temos recebido muitos testemunhos de vidas abençoadas pelo ministério. Queremos ouvir o seu." />

  <section class="pad tes-pub" id="publicados" hidden>
    <div class="wrap">
      <div class="eyebrow" data-i18n="tes_pub_e">Para a glória de Deus</div>
      <h2 class="serif tes-pub-h" data-i18n="tes_pub_h">Testemunhos publicados</h2>
      <div class="tes-lista" id="tesLista"></div>
    </div>
  </section>

  <section class="pad tes-sec">
    <div class="wrap tes-grid">
      <div class="tes-txt rv">
        <p class="tes-big" data-i18n="tes_p1">Na Escola de Profetas, nos cursos, nos encontros e nas nossas comunidades, Deus tem tocado vidas, e muitas pessoas têm nos escrito para contar.</p>
        <p data-i18n="tes_p2">Uma palavra profética que se cumpriu, uma cura, uma restauração, um chamado despertado, uma vida de oração renovada: cada testemunho glorifica a Deus e fortalece a fé de quem o lê. Se o nosso ministério abençoou você, conte para nós.</p>

        <figure class="tes-verso">
          <span class="tes-gr" lang="grc">μαρτυρία</span>
          <blockquote data-i18n="tes_verse">“Eles o venceram pelo sangue do Cordeiro e pela palavra do seu testemunho.”</blockquote>
          <figcaption>AP 12.11</figcaption>
        </figure>

        <ol class="tes-passos">
          <li><b>01</b><span data-i18n="tes_s1">Preencha o formulário ao lado com o seu testemunho.</span></li>
          <li><b>02</b><span data-i18n="tes_s2">Nossa equipe lê cada relato com cuidado e oração.</span></li>
          <li><b>03</b><span data-i18n="tes_s3">No formulário você escolhe o alcance: só para a equipe, publicado sem identificar você ou publicado com o seu nome. Você pode mudar de ideia quando quiser.</span></li>
        </ol>
        <p class="tes-nota" data-i18n-html="tes_note">Nenhum testemunho é publicado sem a sua autorização. Veja como cuidamos da sua história na <a href="/privacidade.html#testemunhos">Política de Privacidade</a>.</p>
      </div>

      <div class="tes-form rv">
        <iframe src={`${FORM}?embedded=true`} title="Formulário de testemunho" loading="lazy">Carregando…</iframe>
        <a href={FORM} target="_blank" rel="noopener" class="btn btn-creme tes-abrir"><span data-i18n="tes_open">Abrir o formulário em outra aba</span> ↗</a>
      </div>
    </div>
  </section>
  <Fragment slot="scripts">
    <script is:inline>
      (function () {
        var sec = document.getElementById('publicados'), lista = document.getElementById('tesLista'), dados = [];
        var esc = function (x) { return String(x == null ? '' : x).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
        function desenhar() {
          var en = document.documentElement.lang === 'en';
          lista.innerHTML = dados.map(function (t) {
            var d = new Date(String(t.publicado_em).replace(' ', 'T') + 'Z').toLocaleDateString(en ? 'en-US' : 'pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
            var ps = esc(t.texto).split(/\n{2,}/).map(function (p) { return '<p>' + p.replace(/\n/g, '<br>') + '</p>'; }).join('');
            return '<article class="tes-card" id="t-' + t.id + '"><span class="tes-data">' + esc(d) + '</span><h3>' + esc(t.titulo) + '</h3><div class="tes-texto">' + ps + '</div>' + (t.assinatura ? '<p class="tes-ass">— ' + esc(t.assinatura) + '</p>' : '') + '</article>';
          }).join('');
        }
        fetch('/api/publico/testemunhos').then(function (r) { return r.ok ? r.json() : { testemunhos: [] }; }).then(function (d) {
          dados = d.testemunhos || [];
          if (!dados.length) return;
          sec.hidden = false; desenhar();
          if (location.hash.indexOf('#t-') === 0) { var el = document.getElementById(location.hash.slice(1)); if (el) setTimeout(function () { el.scrollIntoView(); el.classList.add('tes-alvo'); }, 50); }
        }).catch(function () {});
        window.addEventListener('pv:lang', function () { if (dados.length) setTimeout(desenhar, 0); });
      })();
    </script>
  </Fragment>
</Base>

<style is:global>
  .tes-sec{padding-top:20px;border-top:none}
  .tes-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr);gap:56px;align-items:start}
  @media(max-width:980px){.tes-grid{grid-template-columns:1fr}}
  .tes-txt p{margin:0 0 20px;color:var(--areia);font-size:18px;line-height:1.75;font-weight:300}
  .tes-txt .tes-big{font-family:var(--serif);font-size:clamp(26px,2.4vw,34px);line-height:1.3;color:var(--creme);font-weight:400}
  .tes-verso{margin:36px 0;padding:30px 32px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(150deg,rgba(191,137,87,.14),transparent 65%)}
  .tes-gr{font-family:var(--serif);font-size:44px;color:var(--creme);line-height:1}
  .tes-verso blockquote{margin:14px 0 10px;font-family:var(--serif);font-style:italic;font-size:24px;line-height:1.35;color:var(--cobre)}
  .tes-verso figcaption{font-family:var(--mono);font-size:12px;letter-spacing:.16em;color:var(--areia)}
  .tes-passos{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:14px}
  .tes-passos li{display:flex;gap:16px;align-items:baseline;font-size:16px;color:var(--creme);line-height:1.5}
  .tes-passos b{font-family:var(--mono);font-weight:400;font-size:12px;color:var(--cobre)}
  .tes-txt .tes-nota{margin-top:26px;font-size:14px;color:#8C7D6E}
  .tes-nota a{color:var(--areia);border-bottom:1px solid rgba(191,137,87,.6)}
  .tes-form{position:sticky;top:110px;display:flex;flex-direction:column;gap:14px}
  @media(max-width:980px){.tes-form{position:static}}
  .tes-form iframe{width:100%;height:min(80vh,1100px);min-height:620px;border:1px solid var(--line);border-radius:24px;background:#fff}
  .tes-abrir{align-self:flex-start}
  .tes-pub{padding-top:10px;padding-bottom:30px}
  .tes-pub-h{margin:14px 0 28px;font-size:clamp(34px,3.6vw,52px);font-weight:400;line-height:1.05}
  .tes-lista{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,420px),1fr));gap:20px;align-items:start}
  .tes-card{border:1px solid var(--line);border-radius:24px;padding:28px;background:#070605;scroll-margin-top:110px;transition:border-color .4s}
  .tes-card.tes-alvo{border-color:var(--cobre)}
  .tes-card h3{margin:10px 0 14px;font-family:var(--serif);font-weight:400;font-size:28px;line-height:1.15;color:var(--creme)}
  .tes-data{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--cobre)}
  .tes-texto p{margin:0 0 14px;color:var(--areia);font-size:16.5px;line-height:1.75;font-weight:300}
  .tes-ass{margin:6px 0 0;font-family:var(--serif);font-style:italic;font-size:18px;color:var(--creme)}
</style>
