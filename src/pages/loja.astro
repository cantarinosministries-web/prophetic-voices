---
// Vitrine da loja. Os produtos vêm do banco (painel /admin → Loja), então cadastrar
// produto, foto, preço ou estoque não exige novo deploy.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base page="loja" title="Loja — The Prophetic Voices">
  <Fragment slot="head"><link rel="stylesheet" href="/loja/loja.css" /></Fragment>
  <PageHero k="store" eyebrow="Loja The Prophetic Voices" title="Loja"
    lede="Livros, materiais e vestuário. Frete calculado pelo CEP; pagamento por Pix, cartão de crédito, débito ou boleto via Mercado Pago." />
  <section class="pad lj-sec"><div class="wrap" id="loja" data-pagina="vitrine"></div></section>
  <Fragment slot="scripts"><script is:inline src="/loja/loja.js"></script></Fragment>
</Base>
