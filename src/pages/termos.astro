const VIGENCIA = '22 de novembro de 2026';
const VERSAO = '1.1';
const EMAIL = 'cantarinosministries@gmail.com';
---
<Base page="termos" title="Termos de Uso — The Prophetic Voices" description="Termos de uso do site do ministério The Prophetic Voices: revista, cadastro, comentários, testemunhos, loja e cursos.">
  <section class="pad legal-sec">
    <div class="wrap legal-grade">
      <aside class="legal-indice" aria-label="Sumário">
        <div class="eyebrow">Sumário</div>
        <ol>
          <li><a href="#quem">Quem somos</a></li>
          <li><a href="#natureza">A natureza deste ministério</a></li>
          <li><a href="#conta">Sua conta</a></li>
          <li><a href="#convivencia">Comentários e convivência</a></li>
          <li><a href="#testemunhos">Testemunhos</a></li>
          <li><a href="#revista">Revista e direitos autorais</a></li>
          <li><a href="#marca">Nome e marca</a></li>
          <li><a href="#loja">Loja</a></li>
          <li><a href="#cursos">Cursos e comunidades</a></li>
