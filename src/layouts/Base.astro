---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'artigos' | 'cursos' | 'loja';
}
const {
  title = 'The Prophetic Voices — His word, our voice.',
  description = 'Preparando uma geração para serem Vozes Proféticas no tempo do fim.',
  page = 'home',
} = Astro.props;

const SCHOOL = 'https://thepropheticvoices.hotmart.host/escola-de-profetas';
const IG = 'https://www.instagram.com/thepropheticvoices/';
const WA1 = 'https://chat.whatsapp.com/KU6aVf2D7h5L2ZXfK08SOa';
const WA2 = 'https://chat.whatsapp.com/LMVCHliI9AQ3mj7flYstud';
const isHome = page === 'home';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/app/favicon-64.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200;300;400&family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#000000" />
  <link rel="apple-touch-icon" href="/app/apple-touch-icon.png" />
  <link rel="stylesheet" href="/app/install.css" />
  <meta property="og:image" content="https://thepropheticvoices.com.br/app/icone.png" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1200" />
  <meta property="og:image:alt" content="The Prophetic Voices" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:image" content="https://thepropheticvoices.com.br/app/icone.png" />
  <slot name="head" />
</head>
<body class={isHome ? 'locked' : 'ready'}>
  <div class="grain" aria-hidden="true"></div>

  <slot name="intro" />

  <header id="top-nav">
    <nav class="wrap">
      <a href="/index.html" class="logo" aria-label="The Prophetic Voices — Home"><img src="/media/logo-creme.png" alt="The Prophetic Voices" /></a>
      <div class="links" id="navLinks">
        <a href="/index.html" data-i18n="nav_home" class:list={[{ 'nav-active': isHome }]}>Home</a>
        <a href="/index.html#quem-somos" data-i18n="nav_about">Quem Somos</a>
        <a href={SCHOOL} target="_blank" rel="noopener" data-i18n="nav_school">Escola de Profetas</a>
        <a href="/artigos.html" data-i18n="nav_articles" class:list={[{ 'nav-active': page === 'artigos' }]}>Artigos</a>
        <a href="/cursos.html" data-i18n="nav_courses" class:list={[{ 'nav-active': page === 'cursos' }]}>Cursos</a>
        <a href="/testemunhos.html" data-i18n="nav_testimonies" class:list={[{ 'nav-active': page === 'testemunhos' }]}>Testemunhos</a>
        <a href="/spirit-immersion.html" class:list={['nav-si', { 'nav-active': page === 'spirit' }]}>Spirit Immersion 2027</a>
        {/* Loja e Novidades ocultas do menu por decisão do Gabriel (24/11/2026); as páginas continuam no ar. */}
      </div>
      <div class="acts">
        <div class="lang" role="group" aria-label="Idioma / Language">
          <button type="button" data-lang="pt" aria-pressed="true" aria-label="Português">
            <svg width="22" height="15" viewBox="0 0 22 15" aria-hidden="true"><rect width="22" height="15" fill="#009B3A"/><path d="M11 1.6 20 7.5 11 13.4 2 7.5z" fill="#FEDF00"/><circle cx="11" cy="7.5" r="3.4" fill="#002776"/><path d="M7.8 6.9c2.2-.5 4.5-.2 6.4.9" stroke="#fff" stroke-width=".6" fill="none"/></svg><span>PT</span>
          </button>
          <button type="button" data-lang="en" aria-pressed="false" aria-label="English">
            <svg width="22" height="15" viewBox="0 0 22 15" aria-hidden="true"><rect width="22" height="15" fill="#fff"/><g fill="#B22234"><rect y="0" width="22" height="1.15"/><rect y="2.3" width="22" height="1.15"/><rect y="4.6" width="22" height="1.15"/><rect y="6.9" width="22" height="1.15"/><rect y="9.2" width="22" height="1.15"/><rect y="11.5" width="22" height="1.15"/><rect y="13.85" width="22" height="1.15"/></g><rect width="9.4" height="8.05" fill="#3C3B6E"/></svg><span>EN</span>
          </button>
        </div>
        <button type="button" class="icon-btn menu-btn" id="menuBtn" aria-label="Abrir menu" aria-expanded="false" aria-controls="navLinks"><svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M0 1h18M0 7h18M0 13h18"/></svg></button>
        <a href="/entrar.html" class="icon-btn conta-btn" id="contaBtn" aria-label="Entrar ou criar conta"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></a>
        <a href="/carrinho.html" class="icon-btn" aria-label="Carrinho" hidden style="display:none"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg><span class="count" id="cartCount">0</span></a>
      </div>
    </nav>
  </header>

  <main>
    <slot />

    <section id="comunidade" class="pad">
      <div class="wrap comm rv">
        <div>
          <div class="eyebrow" data-i18n="comm_eyebrow">Comunidade</div>
          <h2 class="disp" style="font-size:clamp(38px,4.2vw,66px);margin-top:18px"><span data-i18n="comm_h1">Acesse nossos conteúdos</span><br /><span class="serif it" style="text-transform:none;color:var(--cobre)" data-i18n="comm_h2">através de nossas comunidades:</span></h2>
          <p style="color:var(--areia);font-size:19px;line-height:1.6;font-weight:300;margin-top:20px;max-width:520px" data-i18n="comm_p">Entre na comunidade The Prophetic Voices no WhatsApp e acompanhe pelo Instagram.</p>
        </div>
        <div class="comm-links">
          <a href={WA1} target="_blank" rel="noopener" class="comm-card"><span>WhatsApp</span><b data-i18n="g1">WhatsApp · Grupo 1</b><i>→</i></a>
          <a href={WA2} target="_blank" rel="noopener" class="comm-card"><span>WhatsApp</span><b data-i18n="g2">WhatsApp · Grupo 2</b><i>→</i></a>
          <a href={IG} target="_blank" rel="noopener" class="comm-card"><span>Instagram</span><b>@thepropheticvoices</b><i>→</i></a>
        </div>
      </div>
    </section>
  </main>

  <footer id="contato">
    <div class="wrap">
      <div class="foot-top">
        <div style="flex:1 1 420px">
          <h2 class="serif" style="margin:0;font-size:44px;line-height:1.05"><span data-i18n="news_h1">Receba os novos artigos</span> <span class="it" style="color:var(--cobre)" data-i18n="news_h2">e testemunhos no seu e-mail.</span></h2>
          <p id="newsPending" class="news-nota" data-i18n="news_pending">As inscrições por e-mail abrem em breve.</p>
          <form class="news" id="newsForm" hidden style="display:none" novalidate>
            <label for="em" class="sr">E-mail</label>
            <input id="em" type="email" data-i18n-ph="news_ph" placeholder="seu@email.com" />
            <button type="submit" class="btn btn-creme" style="height:54px" data-i18n="news_btn">Inscrever</button>
          </form>
          <p class="news-msg" id="newsMsg" role="status" aria-live="polite"></p>
          <p class="news-nota" id="newsNote" hidden data-i18n-html="news_note">Você recebe um e-mail para confirmar. Pode cancelar quando quiser. <a href="/privacidade.html">Política de Privacidade</a>.</p>
        </div>
        <div class="cols">
          <div><span data-i18n="f_nav">NAVEGAR</span><a href="/index.html#quem-somos" data-i18n="nav_about">Quem Somos</a><a href={SCHOOL} target="_blank" rel="noopener" data-i18n="nav_school">Escola de Profetas</a><a href="/artigos.html" data-i18n="nav_articles">Artigos</a><a href="/cursos.html" data-i18n="nav_courses">Cursos</a><a href="/spirit-immersion.html">Spirit Immersion 2027</a></div>
          <div><span data-i18n="f_contact">CONTATO</span><a href="https://wa.me/5599920017003" target="_blank" rel="noopener">WhatsApp · +55 99 92001-7003</a><a href="https://wa.me/5511960578932" target="_blank" rel="noopener"><span data-i18n="f_agenda">Agenda</span> · +55 11 96057-8932</a><a href={IG} target="_blank" rel="noopener">Instagram · @thepropheticvoices</a></div>
          <div><span data-i18n="f_comm">COMUNIDADE</span><a href={WA1} target="_blank" rel="noopener" data-i18n="g1">WhatsApp · Grupo 1</a><a href={WA2} target="_blank" rel="noopener" data-i18n="g2">WhatsApp · Grupo 2</a></div>
        </div>
      </div>
      <p class="sign" data-i18n-html="sign">Vozes proféticas<br />no tempo do fim.</p>
      <div class="legal">
        <span>THE PROPHETIC VOICES · 2026</span>
        {isHome ? <button type="button" id="replay" data-i18n="replay">↺ REVER ABERTURA</button> : <span></span>}
        <span class="legal-links"><a href="/instalar.html" data-i18n="f_install">INSTALAR NO CELULAR</a> · <a href="/termos.html" data-i18n="f_terms">TERMOS</a> · <a href="/privacidade.html" data-i18n="f_privacy">PRIVACIDADE</a></span>
      </div>
    </div>
  </footer>

  <dialog id="pvInstallDialog" class="pwa-dialog" aria-labelledby="pvInstallTitle">
    <h2 id="pvInstallTitle" data-i18n="inst_dlg_h">Instalar no celular</h2>
    <p id="pvInstallHelp"></p>
    <p data-i18n="inst_dlg_p">O aplicativo é gratuito e precisa de internet. Use o mesmo login do site.</p>
    <button type="button" class="btn btn-creme sm" data-pwa-close data-i18n="inst_ok">Entendi</button>
  </dialog>
  <script is:inline src="/app/install.js" defer></script>
  <slot name="scripts" />

  <script>
    import { initLang } from '../scripts/i18n.js';

    // na própria home, links "/index.html#secao" só rolam até a seção (sem recarregar)
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[href*="#"]') as HTMLAnchorElement | null;
      if (!a || a.target === '_blank') return;
      const url = new URL(a.href, location.href);
      const here = location.pathname.replace(/index\.html$/, '');
      const there = url.pathname.replace(/index\.html$/, '');
      if (here !== there || !url.hash) return;
      const el = document.getElementById(decodeURIComponent(url.hash.slice(1)));
      if (!el) return;
      e.preventDefault();
      el.scrollIntoView({ behavior: 'smooth' });
      history.replaceState(null, '', url.hash);
    });

    const nav = document.getElementById('top-nav');
    const onScroll = () => nav && nav.classList.toggle('solid', window.scrollY > 60);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('on'); io.unobserve(en.target); } });
    }, { threshold: 0.15 });
    document.querySelectorAll('.rv').forEach((el) => io.observe(el));

    // contador do carrinho compartilhado entre páginas
    const cc = document.getElementById('cartCount');
    const showCart = () => {
      let n = 0;
      try { n = JSON.parse(localStorage.getItem('pv-cart') || '[]').reduce((t: number, i: any) => t + (i && typeof i === 'object' ? (+i.q || 0) : 0), 0); } catch (e) {}
      if (cc) { cc.textContent = String(n); cc.style.display = n ? 'inline-flex' : 'none'; }
    };
    window.addEventListener('pv:cart', showCart);
    showCart();

    // botão da conta do leitor: só aparece quando há algum login configurado (ou o leitor já entrou)
    const cb = document.getElementById('contaBtn') as HTMLAnchorElement | null;
    if (cb) fetch('/api/conta/sessao', { credentials: 'same-origin' }).then((r) => (r.ok ? r.json() : null)).then((d) => {
      if (!d) return;
      if (d.leitor) {
        const p = String(d.leitor.nome || '?').trim().split(/\s+/);
        cb.href = '/conta.html';
        cb.setAttribute('aria-label', 'Minha conta');
        cb.classList.add('on', 'logado');
        cb.innerHTML = `<span class="ini">${((p[0] || '?')[0] + (p.length > 1 ? p[p.length - 1][0] : '')).toUpperCase().replace(/[<>&"]/g, '')}</span>`;
      } else if (d.provedores && d.provedores.length) {
        cb.href = '/entrar.html?volta=' + encodeURIComponent(location.pathname + location.search);
        cb.classList.add('on');
      }
    }).catch(() => {});

    // inscrição nos e-mails de novos artigos e testemunhos (rodapé)
    const nf = document.getElementById('newsForm') as HTMLFormElement | null;
    if (nf) fetch('/api/newsletter').then(async (r) => {
      if (!r.ok || !(await r.json()).disponivel) return;
      nf.hidden = false;
      nf.style.removeProperty('display');
      document.getElementById('newsPending')!.hidden = true;
      document.getElementById('newsNote')!.hidden = false;
    }).catch(() => {});
    nf?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = document.getElementById('newsMsg')!;
      const en = document.documentElement.lang === 'en';
      const email = (document.getElementById('em') as HTMLInputElement).value.trim();
      const btn = nf.querySelector('button') as HTMLButtonElement;
      btn.disabled = true;
      try {
        const r = await fetch('/api/newsletter', { method: 'POST', credentials: 'same-origin', headers: { 'X-PV': '1', 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(d.erro || '');
        msg.textContent = d.ja ? (en ? 'This e-mail is already subscribed.' : 'Este e-mail já está inscrito.') : (en ? 'Almost there: check your inbox and confirm your subscription.' : 'Quase lá: confira sua caixa de entrada e confirme a inscrição.');
        nf.reset();
      } catch (er) {
        msg.textContent = (er as Error).message || (en ? 'Could not subscribe now. Please try again later.' : 'Não foi possível inscrever agora. Tente mais tarde.');
      } finally { btn.disabled = false; }
    });

    // menu no celular
    const mb = document.getElementById('menuBtn');
    const nl = document.getElementById('navLinks');
    mb?.addEventListener('click', () => {
      const aberto = nl!.classList.toggle('open');
      mb.setAttribute('aria-expanded', String(aberto));
      nav?.classList.toggle('menu-aberto', aberto);
    });
    nl?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { nl.classList.remove('open'); nav?.classList.remove('menu-aberto'); mb?.setAttribute('aria-expanded', 'false'); } });

    initLang();
  </script>
</body>
</html>
